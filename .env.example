# Supabase project URL and publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, NEVER prefix with NEXT_PUBLIC_, NEVER commit,
# NEVER import from a Client Component. See lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the deployed site, used for absolute metadata/OG URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
